; Engine configuration file.
; Godot 4.7 — Сонная стройка (Dream Building) v0.7 caves, depth 30, flowing water, split inventories, bed/pillow, lathe, boss «Анаконда»
config_version=5

[application]
config/name="Сонная стройка v0.7"
config/use_custom_user_dir=true
config/custom_user_dir_name="sonnaya_stroyka"
config/description="Dual-world sandbox: build in Dream, anchor what survives into Wake."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
GameSettings="*res://scripts/game_settings.gd"
GameState="*res://scripts/game_state.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

